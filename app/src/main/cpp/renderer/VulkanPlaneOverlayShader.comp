#version 450

// HD replacement overlay pass.
//
// Runs after the plane filter pre-pass and composites HD replacement art
// from a packed atlas over the filtered plane images. Each instance covers
// one replaced OBJ or BG tile at its native screen position; the packed
// alpha byte (carried in the plane image alpha channel) gates writes so a
// replacement only lands on pixels its producer actually won during 2D
// composition, so occlusion and priority survive unchanged. Both stacked
// plane halves are checked per invocation.
//
// HD art rarely has the native silhouette: an upscaled sprite's edge is a
// smooth curve through its blocky outline. The HD alpha at the centre of a
// native pixel tells which side of that outline the pixel was on, so:
//  - on the producer's own pixels the art is blended over the layer beneath
//    (the lower plane), so a corner the curve cuts off shows what is behind
//  - on a pixel the producer didn't win, the art may spill in where its own
//    native pixel was transparent and a neighbouring pixel is the producer's;
//    where its native pixel was opaque the producer was occluded, and the
//    occluder is kept
//
// Sprites share one producer flag, so for them "the producer won" is decided
// by the ownership map (HDPack2D::ObjRank): the rank of the sprite drawn at
// each native pixel. A sprite's art lands only where that sprite won, never on
// a sprite above it, even one without replacement art (a name plate's art
// used to paint over the unreplaced name drawn on it).
//
// Text a game draws into a BG layer (flags bit 2) has no art silhouette to go by:
// every pixel the layer won under a glyph is its ink, and the box around it is
// another layer or the layer's own fill. Its HD glyph blends over the box colour
// sampled next to the ink (the Compatibility composite keeps no layer beneath a
// 2D pixel), and its soft edge may spill onto the box unless a sprite is there.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

struct OverlayInstance
{
    ivec2 destPos;      // native screen coords, may be negative
    uvec2 nativeSize;   // native pixel size
    uvec2 atlasPos;     // scaled atlas texel origin
    uint masks;         // bits 0-7 required flag bits, bits 8-15 rejected bits
    uint flags;         // bit 0 flipH, bit 1 flipV, bit 2 BG-layer text, bits 8-12 blend weight (16 = as-is)
    uint rank;          // bits 0-7 sprite rank (0xFF: BG tile or glyph), bits 8-9 ownership slot,
                        // bits 16-23 span: the instance owns ranks rank..rank+span (a glyph
                        // across several text sprites)
    uint pad;
};

layout(set = 0, binding = 0, std430) readonly buffer InstanceBuffer
{
    OverlayInstance instances[];
};

layout(set = 0, binding = 1, rgba8) uniform readonly image2D hdAtlas;
layout(set = 0, binding = 2, rgba8) uniform image2D planes;

// per ownership slot (engine A, engine B, carried), per native pixel: rank of the sprite
// drawn there, 0xFF none (4 per word)
layout(set = 0, binding = 3, std430) readonly buffer RankBuffer
{
    uint rankWords[];
};

layout(push_constant) uniform PushConsts
{
    uint scale;
    uint instanceIndex;
    uint debugTint;
} pc;

bool ownedBy(uint producer, uint requireMask, uint rejectMask)
{
    return (producer & requireMask) != 0u && (producer & rejectMask) == 0u;
}

uint producerAt(ivec2 coord)
{
    return uint(imageLoad(planes, coord).a * 255.0 + 0.5);
}

// the colour of the box around BG-layer text: the nearest native pixels (ring 1, else
// ring 2) the text layer didn't win and no sprite or 3D covers, averaged
vec3 textBoxColour(ivec2 p, uint requireMask, uint rejectMask, vec3 fallback)
{
    int step = int(pc.scale);
    vec3 sum = vec3(0.0);
    float n = 0.0;
    for (int r = 1; r <= 2 && n == 0.0; r++)
    {
        for (int dy = -r; dy <= r; dy++)
        {
            for (int dx = -r; dx <= r; dx++)
            {
                if (max(abs(dx), abs(dy)) != r)
                    continue;
                ivec2 q = ivec2(p.x + dx * step, p.y + dy * step);
                if (q.x < 0 || q.y < 0 || q.x >= 256 * step || q.y >= 192 * step)
                    continue;
                vec4 c = imageLoad(planes, q);
                uint producer = uint(c.a * 255.0 + 0.5);
                if (ownedBy(producer, requireMask, rejectMask) || (producer & 0x90u) != 0u
                    || (producer & 0xC0u) == 0x40u)
                    continue;
                sum += c.rgb;
                n += 1.0;
            }
        }
    }
    return n > 0.0 ? sum / n : fallback;
}

uint rankAt(uint engine, ivec2 scaledCoord)
{
    ivec2 native = scaledCoord / int(pc.scale);
    uint index = engine * (256u * 192u) + uint(native.y) * 256u + uint(native.x);
    return (rankWords[index >> 2u] >> ((index & 3u) * 8u)) & 0xFFu;
}

void main()
{
    OverlayInstance inst = instances[pc.instanceIndex];
    // a sprite under a blend or fade (weight below 16) keeps its native pixels, which
    // carry the effect; the edge pass adds its art's detail after composition
    if (((inst.flags >> 8u) & 0x1Fu) < 16u)
        return;

    uvec2 local = gl_GlobalInvocationID.xy;
    uvec2 scaledSize = inst.nativeSize * pc.scale;
    if (local.x >= scaledSize.x || local.y >= scaledSize.y)
        return;

    int px = inst.destPos.x * int(pc.scale) + int(local.x);
    int py = inst.destPos.y * int(pc.scale) + int(local.y);
    int planeWidth = 256 * int(pc.scale);
    int planeHeight = 192 * int(pc.scale);
    if (px < 0 || px >= planeWidth || py < 0 || py >= planeHeight)
        return;

    uvec2 srcTexel = local;
    uvec2 centreTexel = (local / pc.scale) * pc.scale + uvec2(pc.scale / 2u);
    if ((inst.flags & 1u) != 0u)
    {
        srcTexel.x = scaledSize.x - 1u - srcTexel.x;
        centreTexel.x = scaledSize.x - 1u - centreTexel.x;
    }
    if ((inst.flags & 2u) != 0u)
    {
        srcTexel.y = scaledSize.y - 1u - srcTexel.y;
        centreTexel.y = scaledSize.y - 1u - centreTexel.y;
    }
    vec4 hd = imageLoad(hdAtlas, ivec2(inst.atlasPos + srcTexel));
    // whether the art's own native pixel here was opaque
    float centreAlpha = imageLoad(hdAtlas, ivec2(inst.atlasPos + centreTexel)).a;
    bool nativeInk = centreAlpha >= 0.5;
    // text: this glyph's ink, not a touching neighbour's (thin HD strokes cover little of
    // a native pixel's centre, a neighbour's ink none)
    bool textInk = centreAlpha > 0.15;

    uint requireMask = inst.masks & 0xFFu;
    uint rejectMask = (inst.masks >> 8u) & 0xFFu;
    uint myRank = inst.rank & 0xFFu;
    uint engine = (inst.rank >> 8u) & 3u;
    uint lastRank = myRank + ((inst.rank >> 16u) & 0xFFu);
    bool ranked = myRank != 0xFFu;
    bool text = (inst.flags & 4u) != 0u;
    uint winner = ranked ? rankAt(engine, ivec2(px, py)) : 0xFFu;
    if (ranked)
        nativeInk = winner >= myRank && winner <= lastRank;
    for (int plane = 0; plane < 2; plane++)
    {
        ivec2 coord = ivec2(px, py + plane * planeHeight);
        vec4 existing = imageLoad(planes, coord);
        uint producer = uint(existing.a * 255.0 + 0.5);
        if ((producer & 0xC0u) == 0x40u)
            continue;

        vec3 base = existing.rgb;
        if (text && plane != 0)
            continue;
        if (ownedBy(producer, requireMask, rejectMask) && (!ranked || (winner >= myRank && winner <= lastRank)))
        {
            if (text)
            {
                // the text layer won here: this glyph's ink (blocky native ink the HD glyph
                // doesn't cover becomes the box), or the layer's own box fill (then the glyph
                // image is opaque and carries the fill colour)
                if (textInk)
                {
                    vec4 below = imageLoad(planes, ivec2(px, py + planeHeight));
                    uint belowProducer = uint(below.a * 255.0 + 0.5);
                    vec3 fallback = (belowProducer != 0u && (belowProducer & 0xC0u) != 0x40u) ? below.rgb : existing.rgb;
                    base = textBoxColour(ivec2(px, py), requireMask, rejectMask, fallback);
                }
                else if (hd.a <= 0.0)
                {
                    continue;
                }
            }
            else if (nativeInk && plane == 0)
            {
                // blend over the layer beneath; a 3D pixel there isn't in the planes yet
                vec4 below = imageLoad(planes, ivec2(px, py + planeHeight));
                uint belowProducer = uint(below.a * 255.0 + 0.5);
                if ((belowProducer & 0xC0u) != 0x40u)
                    base = below.rgb;
            }
            else if (hd.a <= 0.0)
            {
                continue;
            }
        }
        else
        {
            // occluded: the sprite's own pixel is under something else, or (ranked) a
            // sprite above it won here
            if (plane != 0 || (nativeInk && !text) || hd.a <= 0.0 || (ranked && winner < myRank))
                continue;
            // text spills onto its box, never onto a sprite or 3D in front of it
            if (text && ((producer & 0x90u) != 0u || (producer & 0xC0u) == 0x40u))
                continue;
            bool besideOwn = false;
            int step = int(pc.scale);
            for (int dy = -1; dy <= 1 && !besideOwn; dy++)
            {
                for (int dx = -1; dx <= 1; dx++)
                {
                    ivec2 n = ivec2(px + dx * step, py + dy * step);
                    if ((dx == 0 && dy == 0) || n.x < 0 || n.x >= planeWidth || n.y < 0 || n.y >= planeHeight)
                        continue;
                    if (ownedBy(producerAt(n), requireMask, rejectMask)
                        && (!ranked || (rankAt(engine, n) >= myRank && rankAt(engine, n) <= lastRank)))
                    {
                        besideOwn = true;
                        break;
                    }
                }
            }
            if (!besideOwn)
                continue;
        }

        vec3 blended = mix(base, hd.rgb, hd.a);
        if (pc.debugTint != 0u)
            blended = mix(blended, vec3(1.0, 0.0, 1.0), 0.5);
        imageStore(planes, coord, vec4(blended, existing.a));
    }
}
